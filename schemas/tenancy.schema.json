{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TenancyPolicySchema",
  "description": "Schema for residential tenancy habitability, deposit, and notice policy packs",
  "type": "object",
  "required": [
    "jurisdiction",
    "jurisdictionName",
    "statuteVersion",
    "lastAudited",
    "officialSourceUrl",
    "rules"
  ],
  "properties": {
    "jurisdiction": { "type": "string" },
    "jurisdictionName": { "type": "string" },
    "statuteVersion": { "type": "string" },
    "lastAudited": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "officialSourceUrl": { "type": "string", "format": "uri" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "name",
          "severity",
          "statuteCitation",
          "statuteSummary",
          "officialUrl",
          "triggerPatterns",
          "contraIndicatorPatterns",
          "disputeTemplate"
        ],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "name": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["Standard", "Watch", "LikelyUnenforceable"]
          },
          "statuteCitation": { "type": "string" },
          "statuteSummary": { "type": "string" },
          "officialUrl": { "type": "string", "format": "uri" },
          "triggerPatterns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "contraIndicatorPatterns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "disputeTemplate": { "type": "string" }
        }
      }
    }
  }
}
