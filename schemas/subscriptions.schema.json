{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubscriptionsPolicySchema",
  "description": "Schema for subscription auto-renewal, arbitration, and cancellation policy packs",
  "oneOf": [
    {
      "type": "object",
      "required": ["packId", "name", "version", "jurisdiction", "rules"],
      "properties": {
        "packId": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "description": { "type": "string" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "category", "classification", "severity", "statute", "patterns", "explanation", "recommendation"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string" },
              "classification": { "type": "string" },
              "severity": { "type": "string", "enum": ["CRITICAL", "WARNING", "INFO"] },
              "statute": {
                "type": "object",
                "required": ["code", "title", "jurisdiction", "plainExplanation"],
                "properties": {
                  "code": { "type": "string" },
                  "title": { "type": "string" },
                  "jurisdiction": { "type": "string" },
                  "plainExplanation": { "type": "string" }
                }
              },
              "patterns": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "explanation": { "type": "string" },
              "recommendation": { "type": "string" },
              "tracking": {
                "type": "object",
                "properties": {
                  "agency": { "type": "string" },
                  "docket": { "type": "string" },
                  "statuteCode": { "type": "string" },
                  "cfr": { "type": "string" },
                  "jurisdiction": { "type": "string" },
                  "apiKeywords": { "type": "array", "items": { "type": "string" } },
                  "lastVerifiedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["jurisdictionCode", "jurisdictionName", "statuteTitle", "codification", "lastAudited", "officialSourceUrl", "rules"],
      "properties": {
        "jurisdictionCode": { "type": "string" },
        "jurisdictionName": { "type": "string" },
        "statuteTitle": { "type": "string" },
        "codification": { "type": "string" },
        "lastAudited": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "officialSourceUrl": { "type": "string", "format": "uri" },
        "regulatoryStatus": { "type": "object" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "category", "trapName", "severity", "statutoryCitation", "statuteSummary", "triggerPatterns", "disputeTemplate"],
            "properties": {
              "id": { "type": "string" },
              "category": { "type": "string" },
              "trapName": { "type": "string" },
              "severity": { "type": "string", "enum": ["Unlawful", "Watch", "Standard"] },
              "statutoryCitation": { "type": "string" },
              "vacatedRuleReference": { "type": "string" },
              "statuteSummary": { "type": "string" },
              "triggerPatterns": { "type": "array", "items": { "type": "string" } },
              "negativeExceptions": { "type": "array", "items": { "type": "string" } },
              "disputeTemplate": { "type": "string" }
            }
          }
        }
      }
    }
  ]
}
